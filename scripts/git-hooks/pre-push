#!/usr/bin/env bash

# Git pre-push hook: Prevent direct pushes to main branch
remote="$1"
url="$2"

z40="0000000000000000000000000000000000000000"

while read local_ref local_sha remote_ref remote_sha
do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo ""
        echo "======================================================================"
        echo " [BLOCKED] Direct pushen naar 'main' is niet toegestaan!"
        echo "======================================================================"
        echo " Alle nieuwe ontwikkelingen moeten op een 'feat/' branch worden gedaan."
        echo ""
        echo " Volg deze stappen:"
        echo "   1. Maak een feature branch aan:"
        echo "      git checkout -b feat/<jouw-feature-naam>"
        echo "   2. Push je branch naar GitHub:"
        echo "      git push -u origin feat/<jouw-feature-naam>"
        echo "   3. Open een Pull Request naar 'main' op GitHub."
        echo "======================================================================"
        echo ""
        exit 1
    fi
done

exit 0
